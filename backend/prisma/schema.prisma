// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/.prisma"
  output   = "../node_modules/.prisma" //padrao do prisma-client-js
}

datasource db {
  provider = "mysql"
}



// 1. Usuários da Loja (Clientes e Administradores)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hash de senha seguro (ex: bcrypt/argon2)
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  role      Role     @default(CUSTOMER) // <-- Adicione essa linha (Padrão: Cliente)
}

// 2. Categorias (ex: Saias, Blusas, Vestidos)
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique // ex: saias-midis (bom para as URLs no Next.js)
  products  Product[]
}

// 3. O Produto Geral
model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String           @db.Text
  price       Decimal          @db.Decimal(10, 2) // Evita problemas de precisão com float
  images      String           // JSON string ou texto separado por vírgula para as URLs das fotos
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
}

// 4. As Variações de Tamanho/Cor (Onde fica o estoque real)
model ProductVariant {
  id        String   @id @default(uuid())
  sku       String   @unique // Stock Keeping Unit (ex: BLUSA-PRETA-P)
  estampa   String   @default("Liso") // ex: "Floral", "Listrada", "Lisa"
  color     String   // ex: "Preto", "Off-White"
  size      String   // ex: "P", "M", "G", "Único"
  stock     Int      @default(0) // Estoque específico desta peça
  price     Decimal? @db.Decimal(10, 2) // Caso um tamanho maior ou cor especial tenha preço diferente (opcional)
  active    Boolean  @default(true)
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  orderItems OrderItem[]
}

// 5. Pedidos
model Order {
  id            String      @id @default(uuid())
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(10, 2)
  shippingCost  Decimal     @db.Decimal(10, 2)
  paymentMethod String      // "PIX" ou "CREDIT_CARD"
  paymentId     String?     @unique // ID retornado pelo Mercado Pago / Stripe
  
  // Dados de Entrega Simplificados (Guarda texto para histórico, mesmo se o usuário mudar de endereço depois)
  shippingAddress String   @db.Text 
  trackingCode    String?   // Código de rastreamento dos Correios/Transportadora

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

// 6. Itens do Pedido (Fotografia do momento da compra)
model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // Preço cobrado na hora (se houver promoção futura, não altera o histórico)

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

// Enum de Status do Pedido
enum OrderStatus {
  PENDING     // Aguardando pagamento (gerou o PIX)
  PAID        // Pago (Aprovado pelo webhook do Mercado Pago)
  SHIPPED     // Despachado (Etiqueta gerada e enviado)
  DELIVERED   // Entregue ao cliente
  CANCELLED   // Cancelado por falta de pagamento ou estorno
}

// Adicione este Enum no final do arquivo prisma.schema
enum Role {
  CUSTOMER
  ADMIN
}
